[Unit]
Description=SteamOS Intel Handheld Power Control
Wants=steamos-intel-handheld-restore.service
After=steamos-intel-handheld-restore.service dbus.service systemd-user-sessions.service

[Service]
Type=simple
StateDirectory=steamos-intel-handheld
ExecStart=/opt/steamos-intel-handheld/bin/steamos-intel-handheld-power-control wait-and-serve --user deck --bus system --apply-rapl --apply-msi-claw-ec --ec-write-debounce-ms 750 --tdp-policy auto --msi-claw-ec-shift-policy tdp-threshold --prepare-mangohud-sensors --game-power-mode gpu-priority --game-power-cpu-cap on --game-power-pcore-max-mhz 3000 --game-power-ecore-max-mhz 2400 --game-power-cpu-cap-core-share-threshold 0.30 --game-power-control-file /run/steamos-intel-handheld/game-power-control.json --min-w 8 --max-w 30 --short-limit-max-w 37 --state-file /var/lib/steamos-intel-handheld/tdp_w
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

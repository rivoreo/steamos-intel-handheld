# Requirements: add GET /conversation/:id/export returning the conversation
# as a Markdown attachment. Acceptance: owner gets the file; non-owner 403;
# deleted conversation 404.
# ASSUMPTION (stated in review surface): export volume is low (<200/day
# projected); a synchronous endpoint is acceptable for v1, no job queue.
# Context: routes in this group are registered under authMiddleware and
# rateLimitMiddleware(1/min per user) — see router/router.go below (unchanged,
# shown for context).

diff --git a/router/conversation_export.go b/router/conversation_export.go
new file mode 100644
--- /dev/null
+++ b/router/conversation_export.go
@@ -0,0 +1,34 @@
+package router
+
+import (
+	"fmt"
+	"net/http"
+
+	"github.com/gin-gonic/gin"
+)
+
+// ExportConversation renders a conversation as Markdown. Ownership is
+// enforced by conversationService.GetOwned, which returns ErrNotOwner /
+// ErrNotFound.
+func ExportConversation(c *gin.Context) {
+	accountId := c.GetString("accountId") // set by authMiddleware
+	convId := c.Param("id")
+	conv, err := conversationService.GetOwned(accountId, convId)
+	if err != nil {
+		respondServiceError(c, err) // maps ErrNotOwner->403, ErrNotFound->404
+		return
+	}
+	md, err := RenderMarkdown(conv.Messages)
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, errEnvelope("render_failed"))
+		return
+	}
+	c.Header("Content-Disposition",
+		fmt.Sprintf("attachment; filename=%s.md", convId))
+	c.Data(http.StatusOK, "text/markdown; charset=utf-8", []byte(md))
+}

diff --git a/router/router.go b/router/router.go
--- a/router/router.go
+++ b/router/router.go
@@ -40,6 +40,7 @@ func RegisterConversationRoutes(g *gin.RouterGroup) {
 	// g uses authMiddleware + rateLimitMiddleware(1, time.Minute)
 	g.GET("/conversation/:id", GetConversation)
+	g.GET("/conversation/:id/export", ExportConversation)
 	g.POST("/conversation/:id/rename", RenameConversation)
 }

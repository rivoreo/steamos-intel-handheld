# Requirements: add a bookmarks page on mobile listing the user's starred
# messages. Acceptance: starred messages listed newest first; tap navigates to
# the conversation; long-press removes the bookmark.

diff --git a/mobile/src/pages/bookmarks/bookmarks.vue b/mobile/src/pages/bookmarks/bookmarks.vue
new file mode 100644
--- /dev/null
+++ b/mobile/src/pages/bookmarks/bookmarks.vue
@@ -0,0 +1,86 @@
+<template>
+  <view class="bookmarks-page">
+    <view class="page-header">
+      <text class="header-title">我的收藏</text>
+    </view>
+    <scroll-view scroll-y class="list" @scrolltolower="loadMore">
+      <view v-for="item in list" :key="item.id" class="bookmark-card"
+            @tap="openConversation(item)" @longpress="removeBookmark(item)">
+        <image class="avatar" :src="item.roleAvatar" />
+        <view class="card-body">
+          <text class="excerpt">{{ item.excerpt }}</text>
+          <text class="timestamp">{{ item.timeText }}</text>
+        </view>
+      </view>
+    </scroll-view>
+  </view>
+</template>
+
+<script>
+export default {
+  data() {
+    return { list: [], page: 1 };
+  },
+  onShow() {
+    this.fetchPage(1);
+  },
+  methods: {
+    fetchPage(page) {
+      uni.showLoading({ title: '加载中' });
+      this.$http.get('/bookmark/list', { page }).then(res => {
+        uni.hideLoading();
+        this.list = page === 1 ? res.data : this.list.concat(res.data);
+        this.page = page;
+      });
+    },
+    loadMore() {
+      this.fetchPage(this.page + 1);
+    },
+    openConversation(item) {
+      uni.navigateTo({ url: '/pages/chat/chat?msgId=' + item.msgId });
+    },
+    removeBookmark(item) {
+      this.$http.delete('/bookmark/' + item.id).then(() => {
+        this.list = this.list.filter(x => x.id !== item.id);
+      });
+    }
+  }
+};
+</script>
+
+<style scoped>
+.page-header {
+  position: fixed;
+  top: 0;
+  height: 44px;
+  width: 100%;
+  background: #0d0d0d;
+  z-index: 999;
+}
+.header-title {
+  font-size: 17px;
+  color: #ffffff;
+}
+.bookmark-card {
+  background: #1a1b20;
+  border-radius: 12px;
+  padding: 14px;
+  margin: 10px 16px;
+  transition: all 0.4s;
+}
+.avatar {
+  width: 36px;
+  height: 36px;
+  border-radius: 50%;
+}
+.timestamp {
+  color: #8a8f98;
+  font-size: 12px;
+}
+</style>

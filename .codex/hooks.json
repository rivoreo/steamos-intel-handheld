{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/harness-hook.py --platform codex",
            "statusMessage": "Checking SteamOS harness status",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scripts/harness-hook.py --platform codex",
            "statusMessage": "Checking SteamOS skill routing",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scripts/harness-hook.py --platform codex",
            "statusMessage": "Checking SteamOS harness commit gate",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scripts/harness-hook.py --platform codex",
            "statusMessage": "SteamOS harness verification gate",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scripts/harness-hook.py --platform codex",
            "statusMessage": "SteamOS harness verification gate",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
